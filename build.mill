//| mill-version: 1.3.1
//| mill-jvm-version: 25
//| mvnDeps:
//| - com.lihaoyi::mill-contrib-jmh:$MILL_VERSION

import mill.*, scalalib.*, scalajslib.*, scalajslib.api.*, scalanativelib.*, scalafmt.*, publish.*
import contrib.jmh.JmhModule
import mill.api.BuildCtx
import build.thirdparty

val scala3 = "3.9.0"
val scalaJS = "1.22.0"
val scalaNative = "0.5.12"

/** The version of this project, derived from git.
  *
  * It is the output of `git describe`. If the working tree is dirty, the
  * current timestamp is appended, so that every build of uncommitted changes
  * gets a unique version.
  */
def publishVersion = Task.Input:
  val dirtyMarker = "-dirty"
  val result = os
    .proc("git", "describe", "--tags", "--always", "--dirty=" + dirtyMarker)
    .call(cwd = Task.ctx().workspace, check = false, stderr = os.Pipe)

  val described =
    if result.exitCode == 0 then result.out.trim().stripPrefix("v")
    else "0.0.0" // no commits yet

  if described.endsWith(dirtyMarker) then
    val timestamp = java.time.format.DateTimeFormatter
      .ofPattern("yyyyMMddHHmmss")
      .withZone(java.time.ZoneOffset.UTC)
      .format(java.time.Instant.now())
    s"${described.dropRight(dirtyMarker.length)}-$timestamp"
  else described

/** Publishing settings for the library modules. */
trait Publish extends PublishModule:
  def publishVersion = build.publishVersion()
  def pomSettings = PomSettings(
    description = "HTML generation for Scala 3, built on context functions",
    organization = "io.crashbox",
    url = "https://github.com/jodersky/qtags",
    licenses = Seq(License.`BSD-3-Clause`),
    versionControl = VersionControl.github("jodersky", "qtags"),
    developers = Seq(
      Developer("jodersky", "Jakob Odersky", "https://github.com/jodersky")
    )
  )
  // The platform is already in the artifact id (`qtags_sjs1_3`,
  // `qtags_native0.5_3`), so drop it from the name: `qtags-jvm` -> `qtags`.
  def artifactName = Task:
    super.artifactName().replaceAll("-(jvm|js|native)$", "")

/** Settings shared by every module built for several platforms. Sources go in
  * `<module>/src`, platform-only ones in `<module>/src-jvm`, `src-js`,
  * `src-native` (and the same under `<module>/test`).
  */
trait CrossPlatform extends ScalaModule, PlatformScalaModule:
  def scalaVersion = scala3
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-encoding", "utf8")

/** Finds `node` on the PATH of the shell running `./mill`. The Mill daemon's
  * own PATH may lack it (e.g. when an IDE started the daemon without nvm).
  */
def nodeExecutable = Task.Input:
  Task.env.get("PATH").toSeq
    .flatMap(_.split(java.io.File.pathSeparatorChar))
    .filter(_.startsWith("/"))
    .map(dir => os.Path(dir) / "node")
    .find(os.isFile(_))
    .fold("node")(_.toString)

/** JS environment for DOM tests: Node.js with jsdom. Install jsdom with
  * `npm install` in qtags/test/js (scripts/test does it).
  */
def jsdomEnv = Task:
  JsEnvConfig.JsDom(
    executable = nodeExecutable(),
    env = Map("NODE_PATH" -> (BuildCtx.workspaceRoot / "qtags" / "test" / "js" / "node_modules").toString)
  )

object qtags extends Module:

  trait Shared extends CrossPlatform, Publish:
    def mvnDeps = Seq(thirdparty.geny)

  // Shared sources:  qtags/src,  qtags/test/src
  // JVM-only:        qtags/src-jvm
  object jvm extends Shared:
    object test extends ScalaTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)

  // JS-only:         qtags/src-js,  qtags/test/src-js
  object js extends Shared, ScalaJSModule:
    def scalaJSVersion = scalaJS
    def mvnDeps = super.mvnDeps() ++ Seq(thirdparty.scalajsDom)
    object test extends ScalaJSTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)
      def jsEnvConfig = jsdomEnv()

  // Native-only:     qtags/src-native,  qtags/test/src-native
  object native extends Shared, ScalaNativeModule:
    def scalaNativeVersion = scalaNative
    object test extends ScalaNativeTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)

  // Reactive UI for Scala.js, in package qtags.sigs: signals (Signal.scala, which
  // does not depend on qtags) and DOM bindings for qtags fragments (ui.scala).
  object sigs extends ScalaJSModule, Publish:
    def pomSettings = super.pomSettings().copy(
      description = "Reactive signals and DOM bindings for qtags, for Scala.js"
    )
    def scalaVersion = scala3
    def scalaJSVersion = scalaJS
    def scalacOptions = qtags.js.scalacOptions
    def moduleDeps = Seq(qtags.js)
    object test extends ScalaJSTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)
      def jsEnvConfig = jsdomEnv()

// JMH benchmarks comparing qtags with scalatags (JVM only).
//   ./mill bench.runJmh                   run all benchmarks
//   ./mill bench.runJmh -prof gc          also report allocations
//   ./mill bench.runJmh -f1 -wi 3 -i 5    quicker, less precise run
object bench extends ScalaModule, JmhModule:
  def scalaVersion = scala3
  def scalacOptions = qtags.jvm.scalacOptions
  def jmhCoreVersion = "1.37"
  def moduleDeps = Seq(qtags.jvm)
  def mvnDeps = super.mvnDeps() ++ Seq(thirdparty.scalatags)

// Examples (each has a README):
//   ./mill examples.components.run > demo.html   a page using a small component library
//   ./mill examples.rendering.run                renderString, render and renderLazy
//   ./mill examples.custom-backend.run           a pretty-printing and a tree-building backend
//   ./mill examples.keg-server.run               a keg app at http://localhost:8080
//   ./mill show examples.sigs-basic.site         signals basics in the browser (Scala.js);
//                                                open index.html in the printed directory
//   ./mill show examples.sigs-multi.site         counters added and removed at run time
//   ./mill show examples.sigs-todomvc.site       TodoMVC in the browser (Scala.js); open
//                                                index.html in the printed directory
object examples extends Module:
  trait Example extends ScalaModule:
    def scalaVersion = scala3
    def scalacOptions = qtags.jvm.scalacOptions

  object components extends Example:
    def moduleDeps = Seq(qtags.jvm)

  object rendering extends Example:
    def moduleDeps = Seq(qtags.jvm)

  object `custom-backend` extends Example:
    def moduleDeps = Seq(qtags.jvm)

  object `keg-server` extends Example:
    def moduleDeps = Seq(examples.components)
    def mvnDeps = Seq(thirdparty.keg)

  /** A Scala.js app using qtags.sigs, with an index.html to open it in a browser. */
  trait BrowserExample extends Example, ScalaJSModule:
    def scalaJSVersion = scalaJS
    def moduleDeps = Seq(qtags.sigs)

    def indexHtml = Task.Source("index.html")

    /** index.html next to the compiled app, ready to open in a browser. */
    def site = Task:
      os.copy(indexHtml().path, Task.dest / "index.html")
      os.copy(fastLinkJS().dest.path / "main.js", Task.dest / "main.js")
      PathRef(Task.dest)

  object `sigs-basic` extends BrowserExample:
    object test extends ScalaJSTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)
      def jsEnvConfig = jsdomEnv()

  object `sigs-multi` extends BrowserExample:
    object test extends ScalaJSTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)
      def jsEnvConfig = jsdomEnv()

  object `sigs-todomvc` extends BrowserExample:
    object test extends ScalaJSTests, TestModule.Utest:
      def mvnDeps = Seq(thirdparty.utest)
      def jsEnvConfig = jsdomEnv()
